# Hedera Account Configuration
# These are for backend operations (optional for frontend-only usage)
MY_ACCOUNT_ID=0.0.YOUR_ACCOUNT_ID
M_PRIVATE_KEY=your_private_key_here

# HashConnect Configuration
VITE_APP_ID="Hedera Gamers Vault"
VITE_PROJECT_ID="hedera-gamers-vault-dapp"
VITE_HEDERA_NETWORK="testnet"

# Pinata IPFS Configuration
# Get these from https://pinata.cloud
VITE_PINATA_JWT=your_pinata_jwt_token_here
VITE_PINATA_GATEWAY=your_gateway_url_here

# Example:
# VITE_PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# VITE_PINATA_GATEWAY=amber-gentle-swan-123.mypinata.cloud